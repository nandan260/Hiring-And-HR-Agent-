APP_ENV=development
APP_NAME=Rent-an-Agent HR Control Plane
API_PREFIX=/api/v1

# PostgreSQL DSN. Leave unset in local dev to auto-start embedded pgserver (PostgreSQL),
# or point to Docker/Managed PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rent_an_agent
DATABASE_URL=

# Security Secrets (GENERATE STRONG RANDOM KEYS IN PRODUCTION)
JWT_SECRET_KEY=dev-only-change-me-in-production-32-bytes-minimum-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key (base64 urlsafe 32-byte key) for encrypting tool credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_ROOT=storage/uploads
MAX_UPLOAD_MB=10
AUTO_SEED_CATALOG=true
